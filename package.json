{
  "name": "performance-evaluation-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "api": "node api/server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run api\"",
    "electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:build-safe": "npm run build && node build-without-admin.js"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "antd": "^5.27.1",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dexie": "^4.2.0",
    "express": "^4.18.2",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^7.6.0",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "terser": "^5.43.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.performance.evaluation.system",
    "productName": "绩效评估系统",
    "directories": {
      "output": "F:/安装包"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "compression": "store",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
